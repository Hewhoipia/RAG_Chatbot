# Qwen3 Model configuration
RAG_QWEN3_ENABLE_THINKING=False
RAG_QWEN3_ENABLE_REASONING=True
RAG_QWEN3_REASONING_PARSER="qwen3"
RAG_QWEN3_TEMP_NON_THINKING=0.7
RAG_QWEN3_TOP_P_NON_THINKING=0.8
RAG_QWEN3_TEMP_THINKING=0.6
RAG_QWEN3_TOP_P_THINKING=0.95
RAG_QWEN3_TOP_K=20
RAG_QWEN3_MIN_P=0.0
RAG_QWEN3_PRESENCE_PENALTY=1.5
RAG_QUEN3_MAX_TOKENS_THINKING=4096
RAG_QUEN3_MAX_TOKENS_NON_THINKING=2048

# Query Analysis configuration
RAG_QUERY_ANALYSIS_ENABLED=True
RAG_QUERY_CLASSIFIER_MODE="hybrid"
RAG_MULTI_QUERY_TOP_K=10
RAG_MULTI_QUERY_TIMEOUT=15.0
RAG_SIMPLE_REWRITE_COUNT=2
RAG_COMPLEX_REWRITE_COUNT=2
RAG_COMPLEX_DECOMP_COUNT=2
RAG_RRF_K=60

# Reranker configuration
RAG_RERANKER_ENABLED=True
RAG_RERANKER_POOL_SIZE=8
RAG_RERANKER_MODEL="BAAI/bge-reranker-large"

# Database (Postgres) configuration
RAG_POSTGRES_ENABLED=True
RAG_DB_HOST="localhost"
RAG_DB_PORT=5432
RAG_DB_USER="postgres"
RAG_DB_PASSWORD="postgres"
RAG_DB_DATABASE="rag_chatbot"
RAG_DB_MIN_SIZE=5
RAG_DB_MAX_SIZE=20

# vLLM Server configuration
RAG_VLLM_BASE_URL="http://localhost:8011/v1"
RAG_VLLM_MODEL_NAME="Qwen3.5-4B"
RAG_VLLM_GPU_MEMORY_UTILIZATION=0.55
RAG_VLLM_MAX_NUM_SEQS=25

# Cache (LanceDB) configuration
RAG_CACHE_ENABLED=True
RAG_CACHE_PERSIST_DIR="cache/lancedb"
RAG_CACHE_EMBEDDING_MODEL="BAAI/bge-m3"
RAG_CACHE_SIMILARITY_THRESHOLD=0.95

# Retrieval configuration
RAG_RETRIEVAL_DATA_DIR="data"
RAG_RETRIEVAL_TOP_K=10
RAG_RETRIEVAL_TOP_PICK=3
RAG_RETRIEVAL_BACKWARD_CONTEXT=2
RAG_RETRIEVAL_FORWARD_CONTEXT=2

# Vector DB (Qdrant) configuration
RAG_QDRANT_HOST="localhost"
RAG_QDRANT_PORT=6333
RAG_QDRANT_COLLECTION="banking_docs"

# Redis (Rate Limiter / Circuit Breaker) configuration
RAG_REDIS_ENABLED=True
RAG_REDIS_HOST="localhost"
RAG_REDIS_PORT=6379
RAG_REDIS_DB=0

# Circuit Breaker configuration
RAG_CIRCUIT_BREAKER_FAILURES=5
RAG_CIRCUIT_BREAKER_RECOVERY=30.0

# Server configuration
RAG_SERVER_HOST="0.0.0.0"
RAG_SERVER_PORT=8010
RAG_RATE_LIMIT_ENABLED=True
RAG_RATE_LIMIT_CAPACITY=10
RAG_RATE_LIMIT_FILL_RATE=1.0
RAG_MAX_CONCURRENT_REQUESTS=25

# Application Mode
RAG_DEMO_MODE=True